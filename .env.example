# Docker Compose configuration
#
# Copy this file to .env at the repository root and adjust the values:
#     cp .env.example .env
# Docker Compose reads it automatically. Every variable is optional: when it is missing or empty, the
# default below is used. Never commit the .env file.
#
# Server settings (CORS...) go in server/.env, which the server container also reads.

# Port of the server on the host machine.
# If you change it, also set VITE_SERVER_URL: the web app looks for the server on port 3000 by default.
# Default: 3000
SERVER_PORT=3000

# Port of the web app on the host machine.
# Default: 8080
WEB_PORT=8080

# URL of the server, as seen from the players' browsers. Written into the web app at build time:
# run `docker compose up --build` after changing it.
# Default: same host as the page, port 3000.
# Example: http://192.168.1.20:3000
VITE_SERVER_URL=

# Public URL of the web app, used in the QR code players scan. Written into the web app at build time.
# Default: the address the console page is opened with.
# Example: http://192.168.1.20:8080
VITE_PUBLIC_URL=
