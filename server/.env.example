# PanicControl server configuration
#
# Copy this file to .env and adjust the values:
#     cp .env.example .env
# `npm run dev` and `npm start` load .env automatically. Every variable is optional: when it is
# missing, the default below is used. Never commit the .env file.

# Port the HTTP and Socket.IO server listens on.
# Default: 3000
PORT=3000

# Maximum number of players in a room. Set it lower, for example 2, to test what happens when a
# room is full without opening many phones.
# Default: 8
MAX_PLAYERS_PER_ROOM=8

# Maximum size in bytes of the data of one game message (console or controller).
# Default: 65536
MAX_MESSAGE_BYTES=65536

# Folder holding the game packages (one sub-folder per game, with its manifest). Relative paths
# are resolved from the server folder.
# Default: ../games
GAMES_DIR=../games
