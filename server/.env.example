# PanicControl server configuration
#
# Copy this file to .env and adjust the values:
#     cp .env.example .env
# `npm run dev` and `npm start` load .env automatically. Every variable is optional: when it is
# missing, the default below is used. Never commit the .env file.

# Port the HTTP and Socket.IO server listens on.
# Default: 3000
PORT=3000
