# PanicControl frontend configuration (Vite)
#
# Copy this file to .env and adjust the values:
#     cp .env.example .env
# Vite reads .env when `npm run dev` or `npm run build` starts: restart it after a change.
# Every variable is optional: when it is missing or empty, the default below is used.
#
# Only variables starting with VITE_ are available in the code, and they end up in the JavaScript
# sent to every browser. Never put a secret here. Never commit the .env file.

# URL of the PanicControl server (HTTP and Socket.IO).
# Default: same host as the page, port 3000. Opening the page at http://192.168.1.20:5173 connects
# to http://192.168.1.20:3000, which also works from phones on the same network.
# Example: https://api.panic-control.example.com
VITE_SERVER_URL=

# Public URL of this frontend, used to build the QR code players scan to join a room.
# It must be reachable from the players' phones: localhost would point to the phone itself.
# Default: the address the console page is opened with.
# Example: http://192.168.1.20:5173
VITE_PUBLIC_URL=
