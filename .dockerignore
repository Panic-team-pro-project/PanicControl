# Only sources and lockfiles go into the build context: dependencies and builds are made in the image
**/node_modules
**/dist
**/coverage
**/*.log
**/*.tsbuildinfo

# Never send secrets to the Docker daemon
**/.env
**/.env.*

# Not needed to build the images
.git
.github
.husky
.vscode
.idea
docs
*.md

# Tests run in CI, not in the images (a server test imports the SDK, which is not in the server image)
**/tests
**/*.test.ts
